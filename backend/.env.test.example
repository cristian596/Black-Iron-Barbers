# Variables para correr los tests del backend localmente.
# Copia este archivo a .env.test y pon tus credenciales reales de Postgres local.
# NUNCA uses aqui la base de datos de desarrollo: DB_NAME debe ser distinto
# (por ejemplo black_iron_test) para no tocar ni borrar datos reales.

DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=black_iron_test

JWT_SECRET=test_secret_solo_para_pruebas
ADMIN_USER=admin_test
ADMIN_PASSWORD=admin_test_12345
FRONTEND_URL=http://localhost:5173
PORT=5055

# Las pruebas fijan su propio EMAIL_VERIF_SECRET (tests/setup.js); no hace falta definirlo aquí.

POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=changeme

DB_USER=changeme
DB_PASSWORD=changeme
DB_HOST=changeme
DB_PORT=changeme
DB_NAME=changeme

PORT=changeme

# Zona horaria de referencia para contenedores/herramientas del sistema.
# El backend fija America/Bogota explícitamente en código (backend/utils/fechas.js)
# y no depende de esta variable, pero se deja aquí como defensa adicional.
TZ=America/Bogota

JWT_SECRET=changeme

ADMIN_USER=changeme
ADMIN_PASSWORD=changeme

FRONTEND_URL=changeme

VITE_API_URL=changeme

# Número de WhatsApp del negocio (solo dígitos, con indicativo de país). Lo usan el botón flotante y los botones
# de /asesorias. Si falta, el front usa el placeholder PENDIENTE_NUMERO y los enlaces no abren ningún chat.
VITE_WHATSAPP_NUMERO=changeme

# Correo saliente (confirmaciones y avisos de citas). Apagado por defecto: sin EMAIL_ENABLED=true no se envía nada.
# Con EMAIL_ENABLED=true el backend exige SMTP_HOST, SMTP_PORT y EMAIL_FROM al arrancar.
# Desarrollo: Mailpit (docker compose --profile dev up -d mailpit; interfaz en http://localhost:8025).
#   SMTP_HOST=mailpit  SMTP_PORT=1025  (sin usuario ni contraseña)
# Producción: un SMTP real (p. ej. Gmail con contraseña de aplicación, Resend o Brevo). NUNCA subas credenciales reales.
EMAIL_ENABLED=false
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Black Iron Barbers <no-reply@example.com>

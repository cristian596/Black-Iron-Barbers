POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=changeme

DB_USER=changeme
DB_PASSWORD=changeme
DB_HOST=changeme
DB_PORT=changeme
DB_NAME=changeme

# SSL hacia PostgreSQL (opcional). Valores validos: false (por defecto; base local o red privada), true (SSL verificando el
# certificado; lo recomendado en una base gestionada) y no-verify (SSL SIN verificar el certificado: solo si el proveedor usa
# su propia CA y true falla). Cualquier otro valor impide arrancar. En produccion con false y un host que no es local, avisa.
DB_SSL=false

# DATABASE_URL (opcional): la URL de conexion que entregan Neon, Supabase, Render, etc. Si se define, tiene prioridad sobre las
# DB_* de arriba (que entonces pueden quedar vacias). Lleva la contrasena: va solo en el .env real / panel del hosting y el
# backend nunca la imprime. El SSL lo decide DB_SSL (se ignora el ?sslmode= de la URL).
# DATABASE_URL=postgresql://usuario:contrasena@host:5432/base

# TRUST_PROXY (opcional): numero EXACTO de proxies entre el cliente y el backend (p. ej. 1 en Render o Railway; comprueba la
# documentacion de tu plataforma). Vacio = no confiar en X-Forwarded-For (correcto sin proxy). Solo se aceptan enteros >= 1:
# NUNCA true, * ni all, porque permitirian falsear la IP y esquivar los limites por IP. Un valor invalido impide arrancar.
TRUST_PROXY=

PORT=changeme

# Zona horaria de referencia para contenedores/herramientas del sistema.
# El backend fija America/Bogota explícitamente en código (backend/utils/fechas.js)
# y no depende de esta variable, pero se deja aquí como defensa adicional.
TZ=America/Bogota

# NODE_ENV: "production" es OBLIGATORIO en el despliegue (activa las exigencias de arranque). En desarrollo: development.
NODE_ENV=development

# JWT_SECRET: aleatorio y de al menos 32 caracteres (el backend no arranca con uno débil o de ejemplo). Generalo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres

ADMIN_USER=changeme
ADMIN_PASSWORD=changeme

FRONTEND_URL=changeme

# VITE_API_URL debe incluir el sufijo /api. En producción: la URL pública del backend con https más /api.
VITE_API_URL=http://localhost:5001/api

# Número de WhatsApp del negocio (solo dígitos, con indicativo de país). Lo usan el botón flotante y los botones
# de /asesorias. Si falta, el front usa el placeholder PENDIENTE_NUMERO y los enlaces no abren ningún chat.
VITE_WHATSAPP_NUMERO=changeme

# ID de medición de Google Analytics 4 (formato G-XXXXXXXXXX; opcional). Es una variable de BUILD del front: se incrusta al compilar.
# Si no está definida, Google Analytics no se carga nunca. Aunque lo esté, el script solo se carga si la persona acepta las cookies analíticas.
# VITE_GA_MEASUREMENT_ID=

# Correo saliente (confirmaciones y avisos de citas). Sin EMAIL_ENABLED=true no se envía nada y no se puede reservar.
# Con EMAIL_ENABLED=true el backend exige SMTP_HOST, SMTP_PORT y EMAIL_FROM al arrancar.
# Desarrollo: va en true con Mailpit levantado (docker compose --profile dev up -d mailpit; interfaz en http://localhost:8025).
#   SMTP_HOST=mailpit  SMTP_PORT=1025  (sin usuario ni contraseña)
# Producción: el backend exige EMAIL_ENABLED=true con un SMTP real válido (p. ej. Gmail con contraseña de aplicación, Resend o Brevo). NUNCA subas credenciales reales.
EMAIL_ENABLED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Black Iron Barbers <no-reply@example.com>

# Verificacion del correo con codigo de 6 digitos (obligatoria en TODAS las reservas; ver "Invariantes de negocio" en CLAUDE.md).
# EMAIL_VERIF_SECRET firma los comprobantes: debe ser PROPIO (distinto de JWT_SECRET), aleatorio y de al menos 32 caracteres.
#   Generalo con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# En desarrollo necesitas EMAIL_ENABLED=true y Mailpit levantado para poder reservar. En produccion el backend NO arranca si falta
# EMAIL_ENABLED=true con SMTP valido o si falta EMAIL_VERIF_SECRET o es debil. No existe ninguna variable para desactivar la verificacion.
EMAIL_VERIF_SECRET=cambia-esto-genera-uno-propio-de-48-bytes

# Recordatorios por correo ~24 h antes de la cita (solo al cliente; ver "Invariantes de negocio" en CLAUDE.md). Apagado por defecto.
# Solo arranca el temporizador con RECORDATORIOS_ENABLED=true Y EMAIL_ENABLED=true (si falta el segundo, el arranque avisa).
# RECORDATORIO_HORAS_ANTES: 1-72 (24 por defecto) · RECORDATORIO_INTERVALO_MIN: 1-60 (5) · RECORDATORIO_MAX_POR_CICLO: tope de
# correos por ciclo (50; respeta el limite diario del SMTP, p. ej. Gmail ~500/dia). Un valor invalido impide arrancar.
RECORDATORIOS_ENABLED=false
RECORDATORIO_HORAS_ANTES=24
RECORDATORIO_INTERVALO_MIN=5
RECORDATORIO_MAX_POR_CICLO=50

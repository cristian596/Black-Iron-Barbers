POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=changeme

DB_USER=changeme
DB_PASSWORD=changeme
DB_HOST=changeme
DB_PORT=changeme
DB_NAME=changeme

PORT=changeme

# Zona horaria de referencia para contenedores/herramientas del sistema.
# El backend fija America/Bogota explícitamente en código (backend/utils/fechas.js)
# y no depende de esta variable, pero se deja aquí como defensa adicional.
TZ=America/Bogota

JWT_SECRET=changeme

ADMIN_USER=changeme
ADMIN_PASSWORD=changeme

FRONTEND_URL=changeme

VITE_API_URL=changeme

# Número de WhatsApp del negocio (solo dígitos, con indicativo de país). Lo usan el botón flotante y los botones
# de /asesorias. Si falta, el front usa el placeholder PENDIENTE_NUMERO y los enlaces no abren ningún chat.
VITE_WHATSAPP_NUMERO=changeme

# Correo saliente (confirmaciones y avisos de citas). Apagado por defecto: sin EMAIL_ENABLED=true no se envía nada.
# Con EMAIL_ENABLED=true el backend exige SMTP_HOST, SMTP_PORT y EMAIL_FROM al arrancar.
# Desarrollo: Mailpit (docker compose --profile dev up -d mailpit; interfaz en http://localhost:8025).
#   SMTP_HOST=mailpit  SMTP_PORT=1025  (sin usuario ni contraseña)
# Producción: un SMTP real (p. ej. Gmail con contraseña de aplicación, Resend o Brevo). NUNCA subas credenciales reales.
EMAIL_ENABLED=false
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Black Iron Barbers <no-reply@example.com>

# Verificacion del correo con codigo de 6 digitos (obligatoria en TODAS las reservas; ver "Verificacion de correo" en CLAUDE.md).
# EMAIL_VERIF_SECRET firma los comprobantes: debe ser PROPIO (distinto de JWT_SECRET), aleatorio y de al menos 32 caracteres.
#   Generalo con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# En desarrollo necesitas EMAIL_ENABLED=true y Mailpit levantado para poder reservar. En produccion el backend NO arranca si falta
# EMAIL_ENABLED=true con SMTP valido, si falta EMAIL_VERIF_SECRET o es debil, o si REQUIRE_EMAIL_VERIFICATION no es true.
EMAIL_VERIF_SECRET=cambia-esto-genera-uno-propio-de-48-bytes

# Recordatorios por correo ~24 h antes de la cita (solo al cliente; ver "Recordatorios" en CLAUDE.md). Apagado por defecto.
# Solo arranca el temporizador con RECORDATORIOS_ENABLED=true Y EMAIL_ENABLED=true (si falta el segundo, el arranque avisa).
# RECORDATORIO_HORAS_ANTES: 1-72 (24 por defecto) · RECORDATORIO_INTERVALO_MIN: 1-60 (5) · RECORDATORIO_MAX_POR_CICLO: tope de
# correos por ciclo (50; respeta el limite diario del SMTP, p. ej. Gmail ~500/dia). Un valor invalido impide arrancar.
RECORDATORIOS_ENABLED=false
RECORDATORIO_HORAS_ANTES=24
RECORDATORIO_INTERVALO_MIN=5
RECORDATORIO_MAX_POR_CICLO=50

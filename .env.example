POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=changeme

DB_USER=changeme
DB_PASSWORD=changeme
DB_HOST=changeme
DB_PORT=changeme
DB_NAME=changeme

PORT=changeme

# Zona horaria de referencia para contenedores/herramientas del sistema.
# El backend fija America/Bogota explícitamente en código (backend/utils/fechas.js)
# y no depende de esta variable, pero se deja aquí como defensa adicional.
TZ=America/Bogota

JWT_SECRET=changeme

ADMIN_USER=changeme
ADMIN_PASSWORD=changeme

FRONTEND_URL=changeme

VITE_API_URL=changeme

# Número de WhatsApp del negocio (solo dígitos, con indicativo de país). Lo usan el botón flotante y los botones
# de /asesorias. Si falta, el front usa el placeholder PENDIENTE_NUMERO y los enlaces no abren ningún chat.
VITE_WHATSAPP_NUMERO=changeme
